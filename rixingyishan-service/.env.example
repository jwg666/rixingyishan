# 复制为 .env 后按需修改；.env 已被 git 忽略

# 服务对外基地址（部署在 nginx 反代后设为公网地址，如 https://example.com/rxys）
RXYS_BASE_URL=http://127.0.0.1:8866

# JWT 签名密钥（必配！未配置时每次启动随机生成，重启会使所有已登录会话失效）
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# 短信供应商：aliyun=真实下发，其他值=mock（固定验证码 123456，仅开发用）
SMS_PROVIDER=mock

# 阿里云短信（SMS_PROVIDER=aliyun 时必填）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 验证码有效期（秒，默认 300）
SMS_CODE_TTL=300
